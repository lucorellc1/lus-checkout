# Add these in Vercel → Project → Settings → Environment Variables.
# Start with your TEST key (sk_test_...). Swap to the live key (sk_live_...) when you're ready for real payments.
STRIPE_SECRET_KEY=sk_test_replace_me

# Shown on the Stripe checkout page and receipts.
SHOP_NAME=Personalized Art Print Cards

# Set to "false" if you hand cards over in person and don't need a mailing address.
COLLECT_SHIPPING=true

# Optional: your site's full address, e.g. https://yourshop.vercel.app
SITE_URL=
